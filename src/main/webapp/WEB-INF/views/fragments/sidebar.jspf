<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<aside class="app-sidebar" id="appSidebar">
    <a href="${pageContext.request.contextPath}/" class="brand-header">
        <div class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M2 12h20"></path>
            </svg>
        </div>
        <div>
            <div class="brand-title">CareFirst</div>
            <div class="brand-sub">Healthcare OS</div>
        </div>
    </a>

    <ul class="nav-menu">
        <c:choose>
            <%-- ADMIN ROLE NAVIGATION --%>
            <c:when test="${sessionScope.USER.role == 'ADMIN'}">
                <li class="nav-item ${activeNav == 'dashboard' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/admin/dashboard">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect></svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'users' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/admin/users">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>Users & Doctors</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'appointments' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/admin/appointments">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span>Appointments</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'analytics' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/admin/analytics">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line></svg>
                        <span>Analytics</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'settings' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/admin/settings">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        <span>System Settings</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'audit' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/admin/audit">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span>Audit Logs</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'dbtest' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/db-test">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
                        <span>DB Connectivity</span>
                    </a>
                </li>
            </c:when>

            <%-- DOCTOR ROLE NAVIGATION --%>
            <c:when test="${sessionScope.USER.role == 'DOCTOR'}">
                <li class="nav-item ${activeNav == 'dashboard' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/doctor/dashboard">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect></svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'schedule' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/doctor/schedule">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span>Schedule Manager</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'appointments' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/doctor/appointments">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                        <span>Consultations</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'records' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/doctor/records">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                        <span>Patient Records</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'feedback' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/doctor/feedback">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        <span>Patient Feedback</span>
                    </a>
                </li>
            </c:when>

            <%-- PATIENT ROLE NAVIGATION --%>
            <c:when test="${sessionScope.USER.role == 'PATIENT'}">
                <li class="nav-item ${activeNav == 'dashboard' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/patient/dashboard">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect></svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'booking' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/patient/doctors">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                        <span>Book Appointment</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'appointments' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/patient/appointments">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span>My Appointments</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'records' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/patient/records">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                        <span>Medical History</span>
                    </a>
                </li>
                <li class="nav-item ${activeNav == 'profile' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/profile">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <span>My Profile</span>
                    </a>
                </li>
            </c:when>

            <c:otherwise>
                <li class="nav-item">
                    <a href="${pageContext.request.contextPath}/">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                        <span>Home</span>
                    </a>
                </li>
            </c:otherwise>
        </c:choose>
    </ul>

    <div class="sidebar-footer">
        <a href="${pageContext.request.contextPath}/logout" class="nav-item" style="list-style: none;">
            <div style="display: flex; align-items: center; gap: 10px; color: var(--danger); font-size: 0.88rem; font-weight: 600; padding: 8px 12px; border-radius: var(--radius-sm); transition: var(--transition);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                <span>Sign Out</span>
            </div>
        </a>
    </div>
</aside>
