<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<header class="app-topbar">
    <div class="topbar-left">
        <button type="button" class="search-btn" id="openPaletteBtn" aria-label="Search and command palette">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Search or jump to...</span>
            <kbd class="shortcut-kbd">⌘K</kbd>
        </button>
    </div>

    <div class="topbar-right">
        <!-- Theme Toggle -->
        <button type="button" class="icon-btn" id="themeToggleBtn" title="Toggle Light / Dark mode" aria-label="Toggle theme">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
        </button>

        <!-- Notification Bell Dropdown -->
        <div style="position: relative;">
            <button type="button" class="icon-btn" id="notifBellBtn" title="Notifications" aria-label="Notifications">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <c:if test="${not empty unreadNotifsCount and unreadNotifsCount > 0}">
                    <span class="badge-unread">${unreadNotifsCount}</span>
                </c:if>
            </button>

            <!-- Dropdown Menu -->
            <div id="notifDropdown" class="modal-card" style="display: none; position: absolute; right: 0; top: 50px; width: 340px; padding: 18px; z-index: 100;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h4 style="font-size: 1rem;">Notifications</h4>
                    <button type="button" id="markAllReadBtn" class="btn btn-ghost btn-sm" style="font-size: 0.76rem;">Mark all read</button>
                </div>
                <div style="font-size: 0.85rem; color: var(--text-muted); text-align: center; padding: 16px;">
                    You are up to date! No unread alerts.
                </div>
            </div>
        </div>

        <!-- User Profile Pill -->
        <c:choose>
            <c:when test="${not empty sessionScope.USER}">
                <a href="${pageContext.request.contextPath}/profile" class="user-pill">
                    <div class="avatar-initials">
                        <c:out value="${sessionScope.USER.name.substring(0, 1)}" />
                    </div>
                    <div>
                        <div class="user-name-small"><c:out value="${sessionScope.USER.name}" /></div>
                        <div class="user-role-small"><c:out value="${sessionScope.USER.role.displayName}" /></div>
                    </div>
                </a>
                <a href="${pageContext.request.contextPath}/logout" class="btn btn-ghost btn-sm" title="Log out">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                </a>
            </c:when>
            <c:otherwise>
                <a href="${pageContext.request.contextPath}/login" class="btn btn-primary btn-sm">Sign In</a>
            </c:otherwise>
        </c:choose>
    </div>
</header>
