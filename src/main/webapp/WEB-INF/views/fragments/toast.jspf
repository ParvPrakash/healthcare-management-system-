<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<div id="toastContainer" class="toast-container">
    <c:if test="${not empty successMessage or not empty param.success}">
        <div class="toast toast-success">
            <span class="toast-icon">✓</span>
            <span class="toast-msg"><c:out value="${not empty successMessage ? successMessage : (param.success == 'created' ? 'Created successfully!' : (param.success == 'booked' ? 'Appointment confirmed!' : 'Operation completed successfully!'))}" /></span>
        </div>
    </c:if>
    <c:if test="${not empty errorMessage or not empty param.error}">
        <div class="toast toast-error">
            <span class="toast-icon">✕</span>
            <span class="toast-msg"><c:out value="${not empty errorMessage ? errorMessage : param.error}" /></span>
        </div>
    </c:if>
</div>
